<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE). Keys here cannot be build settings. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Starling finds your friends' phones nearby so your agents can talk directly, without a server.</string>
	<!-- Lane C's text (CalendarAccess.purposeString, ADR 0013 decision 6). iOS 17
	     and later need the full-access key; Add to Calendar needs no key (ADR 0018). -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Starling checks when you're busy so friends' agents can find a time without asking you. Event details stay on your iPhone.</string>
	<!-- Lane D's text (PickAPlaceSkill.locationPurpose, ADR 0013 decision 6). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Starling uses your location only while it finds places near you. Your location stays on your iPhone; friends see only the places you suggest.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_starling._tcp</string>
	</array>
	<!-- Lane E2's Wi-Fi Aware services (ADR 0111). Names must match
	     StarlingWiFiAwareService.link and .pairing exactly: an invalid
	     name, or a service with neither key, crashes the app. -->
	<key>WiFiAwareServices</key>
	<dict>
		<key>_starling-link._tcp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
		<key>_starling-pair._tcp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
	</dict>
</dict>
</plist>
